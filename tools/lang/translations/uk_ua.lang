# Ukrainian - our own text; vanilla names come from Mojang (tools/lang/build_langs.py)
generator.cavesandcliffs=Caves & Cliffs
config.cavesandcliffsbackport.deepslate=Глибосланець і камінь
config.cavesandcliffsbackport.deepslate.tooltip=Глибосланець і блоки з нього, кальцит, туф, гладкий базальт, глибосланцеві руди та необроблені метали.
config.cavesandcliffsbackport.copper=Мідь
config.cavesandcliffsbackport.copper.tooltip=Мідна руда, необроблена мідь, мідні блоки з їхнім окисненням, вощенням і очищенням, а також блискавичники.
config.cavesandcliffsbackport.amethyst=Аметист
config.cavesandcliffsbackport.amethyst.tooltip=Аметист, родючий аметист і його зародки, тоноване скло, підзорна труба та жеоди.
config.cavesandcliffsbackport.dripstone=Крапельний камінь
config.cavesandcliffsbackport.dripstone.tooltip=Крапельний камінь, загострений крапельний камінь, казан із лавою та карстові печери.
config.cavesandcliffsbackport.lush=Зарослі печери
config.cavesandcliffsbackport.lush.tooltip=Мох, азалія, печерна лоза та сяючі ягоди, краплелист, спороцвіти, сяючий лишайник, кореневий ґрунт, звисаюче коріння та зарослі печери.
config.cavesandcliffsbackport.powderSnow=Сипкий сніг
config.cavesandcliffsbackport.powderSnow.tooltip=Сипкий сніг, замерзання, відро з сипким снігом і казан із сипким снігом.
config.cavesandcliffsbackport.candles=Свічки
config.cavesandcliffsbackport.candles.tooltip=Свічки та торти зі свічкою.
config.cavesandcliffsbackport.glowSquid=Сяючий спрут
config.cavesandcliffsbackport.glowSquid.tooltip=Сяючі спрути, сяючі чорнильні мішки та сяючі рамки.
config.cavesandcliffsbackport.axolotls=Аксолотлі
config.cavesandcliffsbackport.axolotls.tooltip=Аксолотлі та відро з аксолотлем.
config.cavesandcliffsbackport.goats=Кози
config.cavesandcliffsbackport.goats.tooltip=Кози та кози, що кричать.
config.cavesandcliffsbackport.blocks=Інші блоки та предмети
config.cavesandcliffsbackport.blocks.tooltip=Блок світла, досягнення «Печери та скелі» та невеликі зміни 1.17 для лопат, шалкерів, здобичі з мобів, скелезубів, лам і заражених блоків.
config.cavesandcliffsbackport.music=Музика
config.cavesandcliffsbackport.music.tooltip=Музика з 1.18 і платівка «otherside».
config.cavesandcliffsbackport.caves=Печерні області
config.cavesandcliffsbackport.caves.tooltip=Де розташовані зарослі та карстові печери: області, які прикрашають печерні потоки.
config.cavesandcliffsbackport.height=Висота світу
config.cavesandcliffsbackport.height.tooltip=Висота світу з 1.18, від y -64 до 319, для нових світів типу «Caves & Cliffs».
config.cavesandcliffsbackport.deepslate.enabled=Увімкнено
config.cavesandcliffsbackport.deepslate.enabled.tooltip=Глибосланець, його сходи, плити та стіни, кальцит, туф, гладкий базальт, глибосланцеві руди, необроблене залізо та необроблене золото. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.deepslate.rawOreDrops=Випадіння необроблених металів
config.cavesandcliffsbackport.deepslate.rawOreDrops.tooltip=Із залізної та золотої руди, як у 1.17, випадає необроблене залізо та необроблене золото, а не сама руда. Із «Шовковим дотиком» і далі випадає руда. Якщо вимкнено, вони, як і глибосланцеві залізна та золота руди, випадають самі.
config.cavesandcliffsbackport.deepslate.generate=Генерація
config.cavesandcliffsbackport.deepslate.generate.tooltip=У нових чанках унизу світу з'являється шар глибосланцю з рудами та туфом.
config.cavesandcliffsbackport.deepslate.layerTop=Верх шару
config.cavesandcliffsbackport.deepslate.layerTop.tooltip=Висота, нижче якої камінь може стати глибосланцем. Між layerFull і цією висотою таких блоків стає дедалі менше.
config.cavesandcliffsbackport.deepslate.layerFull=Суцільний шар
config.cavesandcliffsbackport.deepslate.layerFull.tooltip=Висота, нижче якої весь камінь стає глибосланцем.
config.cavesandcliffsbackport.deepslate.tuff=Туф
config.cavesandcliffsbackport.deepslate.tuff.tooltip=У шарі глибосланцю з'являються скупчення туфу.
config.cavesandcliffsbackport.deepslate.dimensions=Виміри
config.cavesandcliffsbackport.deepslate.dimensions.tooltip=Виміри, у яких з'являється шар глибосланцю.
config.cavesandcliffsbackport.deepslate.skipWorldTypes=Виключені типи світів
config.cavesandcliffsbackport.deepslate.skipWorldTypes.tooltip=Типи світів (їхні назви, як у level.dat), у яких шар глибосланцю ніколи не з'являється.
config.cavesandcliffsbackport.copper.enabled=Увімкнено
config.cavesandcliffsbackport.copper.enabled.tooltip=Мідна руда, необроблена мідь, мідні блоки та блискавичники. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.copper.oxidation=Окиснення
config.cavesandcliffsbackport.copper.oxidation.tooltip=Невощені мідні блоки повільно окиснюються: стають нараженими, потім вивітреними, потім окисненими.
config.cavesandcliffsbackport.copper.lightningRods=Блискавичники
config.cavesandcliffsbackport.copper.lightningRods.tooltip=Блискавка під час грози натомість влучає в найближчий блискавичник у радіусі 128 блоків.
config.cavesandcliffsbackport.copper.waxItems=Предмети для вощення
config.cavesandcliffsbackport.copper.waxItems.tooltip=Предмети, які покривають мідь воском, якщо використати їх на ній або скрафтити з нею (реєстрові імена). Підходить і будь-який предмет із назвою в словнику руд honeycomb.
config.cavesandcliffsbackport.copper.generate=Генерація
config.cavesandcliffsbackport.copper.generate.tooltip=У нових чанках з'являється мідна руда.
config.cavesandcliffsbackport.copper.veinsPerChunk=Жил на чанк
config.cavesandcliffsbackport.copper.veinsPerChunk.tooltip=Кількість жил мідної руди на чанк.
config.cavesandcliffsbackport.copper.veinSize=Розмір жили
config.cavesandcliffsbackport.copper.veinSize.tooltip=Найбільша кількість блоків мідної руди в жилі.
config.cavesandcliffsbackport.copper.minY=Найменша висота
config.cavesandcliffsbackport.copper.minY.tooltip=Найменша висота жили мідної руди.
config.cavesandcliffsbackport.copper.maxY=Найбільша висота
config.cavesandcliffsbackport.copper.maxY.tooltip=Найбільша висота жили мідної руди.
config.cavesandcliffsbackport.amethyst.enabled=Увімкнено
config.cavesandcliffsbackport.amethyst.enabled.tooltip=Аметистові блоки, зародки та уламки, тоноване скло та підзорна труба. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.amethyst.geodes=Жеоди
config.cavesandcliffsbackport.amethyst.geodes.tooltip=У нових чанках під землею з'являються аметистові жеоди.
config.cavesandcliffsbackport.amethyst.geodeRarity=Рідкісність жеод
config.cavesandcliffsbackport.amethyst.geodeRarity.tooltip=У середньому одна жеода на стільки чанків.
config.cavesandcliffsbackport.amethyst.geodeMinY=Найменша висота жеод
config.cavesandcliffsbackport.amethyst.geodeMinY.tooltip=Найменша висота жеоди.
config.cavesandcliffsbackport.amethyst.geodeMaxY=Найбільша висота жеод
config.cavesandcliffsbackport.amethyst.geodeMaxY.tooltip=Найбільша висота жеоди.
config.cavesandcliffsbackport.dripstone.enabled=Увімкнено
config.cavesandcliffsbackport.dripstone.enabled.tooltip=Блоки крапельного каменю, загострений крапельний камінь і казан із лавою. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.dripstone.extraCopperVeins=Додаткові мідні жили
config.cavesandcliffsbackport.dripstone.extraCopperVeins.tooltip=Додаткові спроби створити жилу мідної руди в кожному новому чанку карстової печери. 0 — без них.
config.cavesandcliffsbackport.lush.enabled=Увімкнено
config.cavesandcliffsbackport.lush.enabled.tooltip=Мох, азалії, печерна лоза, краплелист, спороцвіти, сяючий лишайник, кореневий ґрунт і звисаюче коріння. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.lush.glowLichen=Сяючий лишайник
config.cavesandcliffsbackport.lush.glowLichen.tooltip=У нових чанках на стінах печер росте сяючий лишайник.
config.cavesandcliffsbackport.lush.lichenTries=Спроби лишайника
config.cavesandcliffsbackport.lush.lichenTries.tooltip=Скільки разів на чанк під землею пробується розмістити сяючий лишайник. Більшість спроб припадає на суцільний камінь.
config.cavesandcliffsbackport.lush.azaleaTrees=Азалієві дерева
config.cavesandcliffsbackport.lush.azaleaTrees.tooltip=Над зарослими печерами на поверхні ростуть азалієві дерева, від яких до печери тягнеться кореневий ґрунт.
config.cavesandcliffsbackport.powderSnow.enabled=Увімкнено
config.cavesandcliffsbackport.powderSnow.enabled.tooltip=Сипкий сніг, відро й казан із ним, а також замерзання. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.powderSnow.freezing=Замерзання
config.cavesandcliffsbackport.powderSnow.freezing.tooltip=Істоти в сипкому снігу замерзають: через 7 секунд вони отримують шкоду кожні 2 секунди. Якщо вимкнено, сипкий сніг лише сповільнює та затягує.
config.cavesandcliffsbackport.powderSnow.strayConversion=Перетворення на примар
config.cavesandcliffsbackport.powderSnow.strayConversion.tooltip=Скелети, які залишаються в сипкому снігу, перетворюються на примар.
config.cavesandcliffsbackport.powderSnow.cauldronSnow=Сніг у казанах
config.cavesandcliffsbackport.powderSnow.cauldronSnow.tooltip=Снігопад поступово наповнює казани під відкритим небом сипким снігом.
config.cavesandcliffsbackport.powderSnow.patches=Поклади
config.cavesandcliffsbackport.powderSnow.patches.tooltip=У нових чанках на засніжених височинах з'являються поклади сипкого снігу.
config.cavesandcliffsbackport.powderSnow.patchRarity=Рідкісність покладів
config.cavesandcliffsbackport.powderSnow.patchRarity.tooltip=Один чанк зі стількох шукає місце для покладу. Підходить лише засніжена земля на найменшій висоті або вище.
config.cavesandcliffsbackport.powderSnow.patchMinY=Найменша висота покладів
config.cavesandcliffsbackport.powderSnow.patchMinY.tooltip=Найменша висота покладу сипкого снігу.
config.cavesandcliffsbackport.powderSnow.freezeImmuneWearables=Одяг від замерзання
config.cavesandcliffsbackport.powderSnow.freezeImmuneWearables.tooltip=Додаткові предмети, що захищають власника від замерзання, окрім шкіряної броні, у вигляді ID предметів. Вдягнені як чоботи, вони також дають змогу ходити сипким снігом.
config.cavesandcliffsbackport.powderSnow.freezeImmuneMobs=Моби, що не замерзають
config.cavesandcliffsbackport.powderSnow.freezeImmuneMobs.tooltip=Додаткові моби, які ніколи не замерзають, окрім примар, білих ведмедів, снігових ґолемів і візера, у вигляді ID істот.
config.cavesandcliffsbackport.powderSnow.freezeHurtsExtraMobs=Моби, вразливі до холоду
config.cavesandcliffsbackport.powderSnow.freezeHurtsExtraMobs.tooltip=Додаткові моби, яким замерзання завдає вп'ятеро більше шкоди, окрім пломенів і магмокубів, у вигляді ID істот.
config.cavesandcliffsbackport.powderSnow.walkableMobs=Моби, що ходять снігом
config.cavesandcliffsbackport.powderSnow.walkableMobs.tooltip=Додаткові моби, які ходять сипким снігом, окрім кроликів, ендермітів і лусківниць, у вигляді ID істот.
config.cavesandcliffsbackport.candles.enabled=Увімкнено
config.cavesandcliffsbackport.candles.enabled.tooltip=Свічки, шістнадцять пофарбованих свічок і торти зі свічкою. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.glowSquid.enabled=Увімкнено
config.cavesandcliffsbackport.glowSquid.enabled.tooltip=Сяючі спрути, сяючі чорнильні мішки та сяючі рамки. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.glowSquid.spawnWeight=Вага появи
config.cavesandcliffsbackport.glowSquid.spawnWeight.tooltip=Як часто сяючі спрути з'являються в темній воді глибоко під землею порівняно з вагами інших мобів (у ванілі: 10). 0 — не з'являються.
config.cavesandcliffsbackport.glowSquid.glowingSigns=Сяючі таблички
config.cavesandcliffsbackport.glowSquid.glowingSigns.tooltip=Сяючий чорнильний мішок, застосований до таблички, змушує її текст сяяти; чорнильний мішок скасовує це.
config.cavesandcliffsbackport.axolotls.enabled=Увімкнено
config.cavesandcliffsbackport.axolotls.enabled.tooltip=Аксолотлі та відро з аксолотлем. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.axolotls.spawning=Поява
config.cavesandcliffsbackport.axolotls.spawning.tooltip=Аксолотлі природно з'являються в зарослих печерах, у воді над глиною.
config.cavesandcliffsbackport.axolotls.spawnCap=Межа появи
config.cavesandcliffsbackport.axolotls.spawnCap.tooltip=Найбільша кількість природно появлених аксолотлів довкола одного гравця.
config.cavesandcliffsbackport.axolotls.breedingItem=Предмет для розведення
config.cavesandcliffsbackport.axolotls.breedingItem.tooltip=Предмет, яким розводять аксолотлів, якщо в грі немає відра з тропічною рибою, у вигляді "mod:item" або "mod:item:metadata". Якщо відро з тропічною рибою в грі є, підходить лише воно.
config.cavesandcliffsbackport.axolotls.huntTargets=Цілі полювання
config.cavesandcliffsbackport.axolotls.huntTargets.tooltip=Моби, на яких аксолотлі полюють у воді, а потім залишають у спокої на дві хвилини. Невстановлені моби пропускаються.
config.cavesandcliffsbackport.axolotls.hostileTargets=Ворожі цілі
config.cavesandcliffsbackport.axolotls.hostileTargets.tooltip=Моби, на яких аксолотлі завжди нападають у воді. Невстановлені моби пропускаються.
config.cavesandcliffsbackport.axolotls.hostilesAttackAxolotls=Вороги нападають на аксолотлів
config.cavesandcliffsbackport.axolotls.hostilesAttackAxolotls.tooltip=Моби, на яких завжди нападають аксолотлі, теж нападають на аксолотлів.
config.cavesandcliffsbackport.goats.enabled=Увімкнено
config.cavesandcliffsbackport.goats.enabled.tooltip=Кози. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.goats.spawnWeight=Вага появи
config.cavesandcliffsbackport.goats.spawnWeight.tooltip=Як часто кози з'являються в біомах зі spawnBiomes порівняно з іншими тваринами цих біомів (вівці — 12, корови — 8, лами — 5). 0 — кози самі не з'являються.
config.cavesandcliffsbackport.goats.spawnBiomes=Біоми появи
config.cavesandcliffsbackport.goats.spawnBiomes.tooltip=Біоми, у яких з'являються кози, групами від 1 до 3, на камені, гравії, снігу та сухому льоду.
config.cavesandcliffsbackport.goats.ramming=Таран
config.cavesandcliffsbackport.goats.ramming.tooltip=Кози таранять гравців і мобів, які стоять нерухомо поруч із ними. Якщо вимкнено, кози ніколи не таранять.
config.cavesandcliffsbackport.blocks.enabled=Увімкнено
config.cavesandcliffsbackport.blocks.enabled.tooltip=Блок світла, досягнення «Печери та скелі» та невеликі зміни 1.17 нижче. Якщо вимкнено, нічого не реєструється й жодна зі змін не діє.
config.cavesandcliffsbackport.blocks.dirtPaths=Ґрунтові стежки
config.cavesandcliffsbackport.blocks.dirtPaths.tooltip=Лопата робить ґрунтову стежку не лише з блоку трави, а й із ґрунту, загрубілого ґрунту, підзолу, грибниці та кореневого ґрунту.
config.cavesandcliffsbackport.blocks.shulkerDuplication=Розмноження шалкерів
config.cavesandcliffsbackport.blocks.shulkerDuplication.tooltip=Відкритий шалкер, у якого влучив снаряд іншого шалкера, телепортується й може залишити по собі нового шалкера — тим рідше, чим більше шалкерів поруч.
config.cavesandcliffsbackport.blocks.cookedMobDrops=Приготована здобич із мобів
config.cavesandcliffsbackport.blocks.cookedMobDrops.tooltip=Зомбі, висушні та зомбі-селяни, що загинули у вогні, кидають запечену картоплю, а білі ведмеді та вартові — смажену рибу.
config.cavesandcliffsbackport.blocks.pufferfishPoison=Отрута скелезуба
config.cavesandcliffsbackport.blocks.pufferfishPoison.tooltip=Скелезуб, якщо його з'їсти, дає Отруєння II замість Отруєння IV.
config.cavesandcliffsbackport.blocks.peacefulLlamas=Мирні лами
config.cavesandcliffsbackport.blocks.peacefulLlamas.tooltip=На мирній складності лами не плюються в гравців.
config.cavesandcliffsbackport.blocks.infestedBlocks=Заражені блоки
config.cavesandcliffsbackport.blocks.infestedBlocks.tooltip=Заражені блоки швидше ламаються кайлом, а заражений кругляк ламається вдвічі швидше за звичайний кругляк.
config.cavesandcliffsbackport.music.enabled=Увімкнено
config.cavesandcliffsbackport.music.enabled.tooltip=Платівка «otherside» і музика з 1.18. Якщо вимкнено, нічого не реєструється.
config.cavesandcliffsbackport.music.gameMusic=Ігрова музика
config.cavesandcliffsbackport.music.gameMusic.tooltip=Чотири треки, додані до ігрової музики в 1.18, звучать разом зі старими в режимах виживання та творчості: Comforting Memories, Floating Dream, Left to Bloom і One More Day.
config.cavesandcliffsbackport.music.biomeMusic=Музика біомів
config.cavesandcliffsbackport.music.biomeMusic.tooltip=У зарослих печерах, карстових печерах і гірських біомах звучить власна добірка треків, як у 1.18.
config.cavesandcliffsbackport.music.menuMusic=Музика меню
config.cavesandcliffsbackport.music.menuMusic.tooltip=П'ять треків, доданих до музики головного меню в 1.18, звучать разом зі старими.
config.cavesandcliffsbackport.music.othersideLoot=«otherside» у скринях
config.cavesandcliffsbackport.music.othersideLoot.tooltip=Платівку «otherside» можна знайти у скринях підземель і у скринях коридорів фортець. Набуває чинності під час наступного завантаження світу.
config.cavesandcliffsbackport.caves.lushRegions=Зарослі області
config.cavesandcliffsbackport.caves.lushRegions.tooltip=Зарослі печери: мох, азалії, печерна лоза, глиняні озерця та краплелист у деяких печерних областях нових чанків.
config.cavesandcliffsbackport.caves.dripstoneRegions=Карстові області
config.cavesandcliffsbackport.caves.dripstoneRegions.tooltip=Карстові печери: крапельний камінь і загострений крапельний камінь у деяких печерних областях нових чанків.
config.cavesandcliffsbackport.height.enabled=Увімкнено
config.cavesandcliffsbackport.height.enabled.tooltip=Тип світу «Caves & Cliffs»: верхній світ від y -64 до 319, як у 1.18. Незер і Енд, а також усі світи, створені раніше, назавжди зберігають висоту від y 0 до 255. Якщо видалити цей мод із такого світу, усе від y 0 до 255 збережеться, а все нижче та вище буде втрачено: корінна порода лежить на y -64, тому низ світу стане відкритим на y 0. Не вмикається й повідомляє про це в журналі, якщо встановлено Cubic Chunks, Caves Not Cliffs або Farmer's Future Delight: вони змінюють ті самі частини гри.
config.cavesandcliffsbackport.height.defaultForNewWorlds=Типово для нових світів
config.cavesandcliffsbackport.height.terrainThreads=Потоки рельєфу
config.cavesandcliffsbackport.height.terrainThreads.tooltip=Робочі потоки, які будують рельєф 1.18 у світі «Caves & Cliffs» з випередженням серверного потоку. 0 — кількість ядер комп'ютера мінус два, від 1 до 6.
config.cavesandcliffsbackport.height.newerBiomes=Новіші біоми
config.cavesandcliffsbackport.height.newerBiomes.tooltip=Нові світи «Caves & Cliffs» з рельєфом 1.18 отримують і біоми новіших версій, для яких установлені бекпорти додають блоки: мангрові болота й глибоку темряву з 1.19 із Wild Update Backport, вишневі гаї з 1.20 із Trails & Tales Backport, розміщені там само, де їх розміщують ці версії. Світи зберігають біоми, з якими їх було створено.
config.cavesandcliffsbackport.height.defaultForNewWorlds.tooltip=Нові світи, які отримали б тип «За замовчуванням», натомість отримують тип «Caves & Cliffs»: у грі наодинці та на сервері, де level-type дорівнює DEFAULT. Діє для світів, створених після цього.
