config.cavesandcliffsbackport.changes.myceliumPlants=Pflanzen auf Myzel
config.cavesandcliffsbackport.changes.myceliumPlants.tooltip=Blumen, Setzlinge, Gras, Farne, tote Büsche und Zuckerrohr lassen sich auf Myzel pflanzen, und Kürbisse und Melonen wachsen darauf (1.17).
config.cavesandcliffsbackport.changes.anvilNames=Längere Ambossnamen
