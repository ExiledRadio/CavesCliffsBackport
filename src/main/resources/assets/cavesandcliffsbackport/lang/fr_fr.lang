config.cavesandcliffsbackport.glowSquid.tooltip=Les poulpes luisants, les poches d'encre luisante et les cadres luisants.
config.cavesandcliffsbackport.axolotls=Axolotls
config.cavesandcliffsbackport.axolotls.tooltip=Les axolotls et l'axolotl dans un seau.
config.cavesandcliffsbackport.goats=Chèvres
