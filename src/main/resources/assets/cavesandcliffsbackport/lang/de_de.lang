config.cavesandcliffsbackport.music=Musik
config.cavesandcliffsbackport.music.tooltip=Die Musik aus 1.18 und die Schallplatte „Otherside“.
config.cavesandcliffsbackport.caves=Höhlenregionen
config.cavesandcliffsbackport.caves.tooltip=Wo üppige Höhlen und Tropfsteinhöhlen liegen: die Regionen, die die Höhlenströme ausgestalten.
